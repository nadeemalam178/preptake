# PrepTake Environment Variables for Vercel
# Configure these in Vercel Dashboard -> Project -> Settings -> Environment Variables

# 1. Google Spreadsheet ID (Required for database verification & direct exports)
NEXT_PUBLIC_GOOGLE_SHEET_ID=14bH4IMp7x5nR3TJEKzt5VtIAq-WivnEPhSFCIfZwfb0

# 2. Google Apps Script Web App Deployment URL (Required for authentication, session verification, and progress synchronization)
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwaRRVTypYkRt6OKKqwXWqBUUIi1QIYgw0esp3Cp4YUit4aDA-MIYm-pOAVqy7q8m1e/exec

# 3. Optional Base Path (Leave empty for standard root Vercel deployments; only set if deploying under a subpath)
